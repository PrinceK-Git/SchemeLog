{
  "name": "schemelog-project",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm ci --prefix client && npm ci --prefix server",
    "dev": "npm run dev --prefix client",
    "preview": "npm run preview --prefix client --",
    "validate:catalogue": "npm run validate:catalogue --prefix server --",
    "validate:registry": "npm run validate:registry --prefix server",
    "build:catalogue": "npm run build:catalogue --prefix server --",
    "build": "npm run validate:registry && npm run build:catalogue && npm run build --prefix client",
    "test": "npm test --prefix client && npm test --prefix server",
    "test:e2e": "npm run test:e2e --prefix client --",
    "sources:fetch": "npm run sources:fetch --prefix server --",
    "sources:extract": "npm run sources:extract --prefix server --",
    "sources:report": "npm run sources:report --prefix server --",
    "sources": "node server/scripts/sources.mjs",
    "format:check": "node client/node_modules/prettier/bin/prettier.cjs --check .",
    "format": "node client/node_modules/prettier/bin/prettier.cjs --write ."
  }
}
