{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemelog.example/schema/catalogue.schema.json",
  "title": "Schemelog published catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogueVersion",
    "publishedAt",
    "vocabVersion",
    "coverage",
    "schemes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "catalogueVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "vocabVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "jurisdictions", "educationLevels", "schemeCount", "statement"],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "student-scholarship"
          }
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(central|state|unknown|IN-[A-Z]{2})$"
          }
        },
        "educationLevels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schemeCount": {
          "type": "integer",
          "minimum": 0
        },
        "statement": {
          "type": "string",
          "minLength": 30,
          "pattern": "^[^<>]*$"
        },
        "quarantined": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "pattern": "^[^<>]*$"
              }
            }
          }
        }
      }
    },
    "schemes": {
      "type": "array",
      "items": {
        "$ref": "https://schemelog.example/schema/scheme.schema.json"
      }
    }
  }
}
