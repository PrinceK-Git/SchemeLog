{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemelog.example/schema/registry.schema.json",
  "title": "Schemelog source registry",
  "description": "Hand-reviewed allowlist of exact official URLs. The fetcher reads nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "userAgent", "hosts", "entries"],
  "properties": {
    "registryVersion": { "type": "integer", "minimum": 1 },
    "userAgent": { "type": "string", "minLength": 10 },
    "hosts": {
      "type": "object",
      "minProperties": 0,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minIntervalMs", "robotsChecked", "termsChecked"],
        "properties": {
          "minIntervalMs": { "type": "integer", "minimum": 1000 },
          "robotsChecked": { "type": "string", "format": "date" },
          "termsChecked": { "type": "string", "format": "date" },
          "notes": { "type": "string" },
          "automatedChecks": {
            "enum": ["allowed", "manual-only"],
            "description": "manual-only keeps a host in the registry for provenance while excluding it from fetching."
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemeId",
          "sourceId",
          "url",
          "kind",
          "expectedType",
          "factGroups",
          "checkEvery",
          "addedBy",
          "reviewedBy"
        ],
        "properties": {
          "schemeId": { "type": "string", "pattern": "^(fx-)?sch-[a-z0-9-]+$" },
          "sourceId": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "kind": { "enum": ["guidelines", "notice", "scheme-page", "portal-page", "faq"] },
          "expectedType": {
            "enum": ["application/pdf", "text/html", "text/plain", "application/xhtml+xml"]
          },
          "factGroups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["eligibility", "benefits", "documents", "application", "links", "identity"]
            }
          },
          "checkEvery": { "type": "string", "pattern": "^P(?=\\d|T)(\\d+D)?(T(\\d+H)?(\\d+M)?)?$" },
          "addedBy": { "type": "string", "minLength": 2 },
          "reviewedBy": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
